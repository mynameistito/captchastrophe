# Public frontend URL. Omit to disable voting.
VITE_CONVEX_URL=
# Set these on the Convex deployment, not in browser code:
# AUTH_GITHUB_CLIENT_ID
# AUTH_GITHUB_CLIENT_SECRET
# ALLOWED_REDIRECT_ORIGINS
# MAINTAINER_GITHUB_IDS
# SYNC_TOKEN
# GITHUB_API_TOKEN (optional, public account lookup rate limit)
# VOTE_MIN_ACCOUNT_AGE_DAYS=7
# VOTE_MAX_CHANGES_PER_MINUTE=10
# GitHub environment secrets: CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, SYNC_TOKEN
# GitHub variables: CLOUDFLARE_WORKERS_SUBDOMAIN, VITE_CONVEX_URL, CONVEX_SITE_URL, HOSTING_ENABLED
